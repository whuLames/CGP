diff --git a/tools/convert_csr_to_ligra_binary.py b/tools/convert_csr_to_ligra_binary.py
new file mode 100644
index 0000000000000000000000000000000000000000..0fecc1fda9777512efbc310765d89e4c0f356880
--- /dev/null
+++ b/tools/convert_csr_to_ligra_binary.py
@@ -0,0 +1,364 @@
+#!/usr/bin/env python3
+"""
+Convert CSR binary format (int32) to Ligra binary format for ForkGraph,
+with optional multi-partition support.
+
+CSR input:
+  csr_vlist.bin      - row offsets (int32 or int64, auto-detected)
+  csr_elist.bin      - column indices (int32)
+  csr_weightlist.bin - edge weights (int32, optional)
+
+Ligra binary output (used with ForkGraph's -b flag):
+  <name>.config  - text file with vertex count
+  <name>.adj     - binary: first E int32 destinations, then E int32 weights
+  <name>.idx     - binary: V int32 offsets (no sentinel)
+
+Multi-partition mode (--num-partitions N, N > 1):
+  Edges are split by whether src and dst are in the same partition.
+  Vertices are assigned to partitions by range: part[v] = v * N / nvtxs.
+  - <name>.inter.* : cross-partition edges
+  - <name>.intra.* : same-partition edges
+
+Single-partition mode (--num-partitions 1, default):
+  - <name>.inter.* : empty graph
+  - <name>.intra.* : the full graph
+
+Usage:
+  python3 convert_csr_to_ligra_binary.py cit-Patents                    # single partition
+  python3 convert_csr_to_ligra_binary.py cit-Patents --num-partitions 4 # 4 partitions
+  python3 convert_csr_to_ligra_binary.py cit-Patents -n 8 --csr-dir /path/to/csr
+"""
+
+import argparse
+import os
+import struct
+import sys
+from pathlib import Path
+
+
+def detect_vlist_dtype(vlist_path: Path) -> str:
+    """Auto-detect vlist data type."""
+    file_size = vlist_path.stat().st_size
+    with open(vlist_path, 'rb') as f:
+        head = f.read(32)
+        f.seek(0, 2)
+        file_size = f.tell()
+
+    n_i64 = file_size // 8
+    vals_i64 = struct.unpack(f'<{min(4, n_i64)}q', head[:min(32, len(head))])
+    i64_valid = vals_i64[0] == 0 and all(vals_i64[i] <= vals_i64[i + 1] for i in range(len(vals_i64) - 1))
+
+    n_i32 = file_size // 4
+    vals_i32 = struct.unpack(f'<{min(8, n_i32)}i', head[:min(32, len(head))])
+    i32_valid = vals_i32[0] == 0 and all(vals_i32[i] <= vals_i32[i + 1] for i in range(len(vals_i32) - 1))
+
+    if i64_valid and not i32_valid:
+        return 'int64'
+    elif i32_valid and not i64_valid:
+        return 'int32'
+    elif i64_valid and i32_valid:
+        elist_path = vlist_path.parent / 'csr_elist.bin'
+        if elist_path.exists():
+            elist_size = elist_path.stat().st_size
+            nedges = elist_size // 4
+            with open(vlist_path, 'rb') as f:
+                f.seek(-8, 2)
+                last_i64 = struct.unpack('<q', f.read(8))[0]
+                f.seek(-4, 2)
+                last_i32 = struct.unpack('<i', f.read(4))[0]
+            if last_i64 == nedges:
+                return 'int64'
+            elif last_i32 == nedges:
+                return 'int32'
+        return 'int64'
+    else:
+        raise ValueError(f"Cannot determine vlist dtype for {vlist_path}")
+
+
+def _load_csr(vlist_path, elist_path, wlist_path, vlist_dtype, nvtxs, nedges):
+    """Load CSR data into memory. Returns (offsets, edges, weights)."""
+    # Load offsets (int64 in memory for convenience)
+    offsets = [0] * (nvtxs + 1)
+    if vlist_dtype == 'int64':
+        with open(vlist_path, 'rb') as f:
+            data = f.read()
+        offsets = list(struct.unpack(f'<{nvtxs + 1}q', data))
+    else:
+        with open(vlist_path, 'rb') as f:
+            data = f.read()
+        i32_offsets = struct.unpack(f'<{nvtxs + 1}i', data)
+        offsets = [int(x) for x in i32_offsets]
+
+    # Load edges
+    with open(elist_path, 'rb') as f:
+        data = f.read()
+    edges = list(struct.unpack(f'<{nedges}i', data))
+
+    # Load weights
+    weights = None
+    if wlist_path and wlist_path.exists():
+        with open(wlist_path, 'rb') as f:
+            data = f.read()
+        weights = list(struct.unpack(f'<{nedges}i', data))
+
+    return offsets, edges, weights
+
+
+def _write_ligra_binary_from_memory(offsets, edges, weights, nvtxs, nedges, out_base):
+    """Write .config, .adj, .idx files from in-memory CSR data."""
+    config_path = Path(str(out_base) + '.config')
+    adj_path = Path(str(out_base) + '.adj')
+    idx_path = Path(str(out_base) + '.idx')
+
+    with open(config_path, 'w') as f:
+        f.write(f"{nvtxs}\n")
+
+    # .idx: V int32 offsets (skip sentinel)
+    with open(idx_path, 'wb') as f:
+        f.write(struct.pack(f'<{nvtxs}i', *offsets[:nvtxs]))
+
+    # .adj: first E dests (int32), then E weights (int32)
+    with open(adj_path, 'wb') as f:
+        f.write(struct.pack(f'<{nedges}i', *edges))
+        if weights:
+            f.write(struct.pack(f'<{nedges}i', *weights))
+        else:
+            f.write(struct.pack(f'<{nedges}i', *([1] * nedges)))
+
+    adj_size = adj_path.stat().st_size
+    idx_size = idx_path.stat().st_size
+    adj_expected = nedges * 8
+    idx_expected = nvtxs * 4
+    ok_adj = '✓' if adj_size == adj_expected else '✗'
+    ok_idx = '✓' if idx_size == idx_expected else '✗'
+    print(f"    .adj: {adj_size:,} bytes (expected {adj_expected:,}) {ok_adj}")
+    print(f"    .idx: {idx_size:,} bytes (expected {idx_expected:,}) {ok_idx}")
+
+
+def _write_empty_graph(nvtxs, out_base):
+    """Write an empty graph (0 edges) in Ligra binary format."""
+    config_path = Path(str(out_base) + '.config')
+    adj_path = Path(str(out_base) + '.adj')
+    idx_path = Path(str(out_base) + '.idx')
+
+    with open(config_path, 'w') as f:
+        f.write(f"{nvtxs}\n")
+
+    with open(idx_path, 'wb') as f:
+        f.write(struct.pack(f'<{nvtxs}i', *([0] * nvtxs)))
+
+    with open(adj_path, 'wb') as f:
+        pass
+
+    print(f"    .adj: 0 bytes (empty graph)")
+    print(f"    .idx: {nvtxs * 4:,} bytes (all zeros)")
+
+
+def _split_edges(offsets, edges, weights, nvtxs, np):
+    """Split edges into inter-partition and intra-partition.
+
+    Vertex partitioning: part[v] = v * np // nvtxs (block/range-based).
+    Returns (inter_offsets, inter_edges, inter_weights,
+             intra_offsets, intra_edges, intra_weights)
+    """
+    # 分区 1..np; 分区 0 预留 1 个顶点避免 load_parts 空分区崩溃
+    # BFS/PPR 用 pi>0，所以有效分区为 1..np
+    part = [v * np // nvtxs + 1 for v in range(nvtxs)]
+    part[0] = 0  # 顶点 0 放在分区 0（占位，避免空分区崩溃）
+
+    inter_edges = [[] for _ in range(nvtxs)]
+    intra_edges = [[] for _ in range(nvtxs)]
+    inter_weights = [[] for _ in range(nvtxs)] if weights else None
+    intra_weights = [[] for _ in range(nvtxs)] if weights else None
+
+    inter_cnt = 0
+    intra_cnt = 0
+
+    for v in range(nvtxs):
+        src_part = part[v]
+        for j in range(offsets[v], offsets[v + 1]):
+            dst = edges[j]
+            dst_part = part[dst]
+            w = weights[j] if weights else 1
+
+            if src_part == dst_part:
+                intra_edges[v].append(dst)
+                if intra_weights is not None:
+                    intra_weights[v].append(w)
+                intra_cnt += 1
+            else:
+                inter_edges[v].append(dst)
+                if inter_weights is not None:
+                    inter_weights[v].append(w)
+                inter_cnt += 1
+
+    # Build CSR offsets
+    def build_csr(edge_lists, weight_lists):
+        off = [0]
+        e_list = []
+        w_list = [] if weight_lists is not None else None
+        for v in range(nvtxs):
+            e_list.extend(edge_lists[v])
+            if w_list is not None:
+                w_list.extend(weight_lists[v])
+            off.append(len(e_list))
+        return off, e_list, w_list
+
+    inter_off, inter_e, inter_w = build_csr(inter_edges, inter_weights)
+    intra_off, intra_e, intra_w = build_csr(intra_edges, intra_weights)
+
+    print(f"  Partitioning: {np} partitions (range-based, "
+          f"~{nvtxs // np:,} vertices each)")
+    print(f"  Inter edges:  {inter_cnt:,} ({100*inter_cnt/(inter_cnt+intra_cnt):.1f}%)")
+    print(f"  Intra edges:  {intra_cnt:,} ({100*intra_cnt/(inter_cnt+intra_cnt):.1f}%)")
+
+    return inter_off, inter_e, inter_w, intra_off, intra_e, intra_w, part
+
+
+def convert_csr_to_ligra_binary(csr_dir: Path, out_dir: Path, dataset_name: str,
+                                 num_partitions: int = 1):
+    """Convert CSR dataset to Ligra binary format (partitioned for ForkGraph)."""
+    vlist_path = csr_dir / 'csr_vlist.bin'
+    elist_path = csr_dir / 'csr_elist.bin'
+    wlist_path = csr_dir / 'csr_weightlist.bin'
+
+    if not vlist_path.exists() or not elist_path.exists():
+        raise FileNotFoundError(f"Missing CSR files in {csr_dir}")
+
+    has_weights = wlist_path.exists()
+    vlist_dtype = detect_vlist_dtype(vlist_path)
+    vlist_size = vlist_path.stat().st_size
+    elist_size = elist_path.stat().st_size
+
+    if vlist_dtype == 'int64':
+        nvtxs = (vlist_size // 8) - 1
+    else:
+        nvtxs = (vlist_size // 4) - 1
+
+    nedges = elist_size // 4
+
+    print(f"Dataset: {dataset_name}")
+    print(f"  Vertices: {nvtxs:,}")
+    print(f"  Edges:    {nedges:,}")
+    print(f"  Vlist dtype: {vlist_dtype}")
+    print(f"  Has weights: {has_weights}")
+    print(f"  Partitions: {num_partitions}")
+    print(f"  Output dir: {out_dir}")
+
+    out_dir.mkdir(parents=True, exist_ok=True)
+
+    if num_partitions <= 1:
+        # --- Single partition mode (original behavior) ---
+        intra_base = out_dir / f"{dataset_name}.intra"
+        _write_ligra_binary(vlist_path, elist_path,
+                            wlist_path if has_weights else None,
+                            vlist_dtype, nvtxs, nedges, intra_base)
+
+        inter_base = out_dir / f"{dataset_name}.inter"
+        _write_empty_graph(nvtxs, inter_base)
+
+        part = [1] * nvtxs
+        part[0] = 0  # 顶点 0 放在分区 0（占位，避免空分区崩溃; 源节点应从分区 1 选）
+    else:
+        # --- Multi-partition mode ---
+        print("  Loading CSR data...")
+        offsets, edges, weights = _load_csr(
+            vlist_path, elist_path,
+            wlist_path if has_weights else None,
+            vlist_dtype, nvtxs, nedges)
+
+        print("  Splitting edges...")
+        inter_off, inter_e, inter_w, intra_off, intra_e, intra_w, part = \
+            _split_edges(offsets, edges, weights, nvtxs, num_partitions)
+
+        inter_m = len(inter_e)
+        intra_m = len(intra_e)
+
+        print("  Writing intra graph...")
+        intra_base = out_dir / f"{dataset_name}.intra"
+        _write_ligra_binary_from_memory(intra_off, intra_e, intra_w,
+                                         nvtxs, intra_m, intra_base)
+
+        print("  Writing inter graph...")
+        inter_base = out_dir / f"{dataset_name}.inter"
+        _write_ligra_binary_from_memory(inter_off, inter_e, inter_w,
+                                         nvtxs, inter_m, inter_base)
+
+    # --- Write partition file ---
+    part_path = out_dir / f"{dataset_name}.part"
+    print(f"  Writing partition file: {part_path}")
+    with open(part_path, 'w') as f:
+        for p in part:
+            f.write(f"{p}\n")
+    print(f"    Done ({nvtxs:,} entries)")
+
+    # --- Write source list (从分区 > 0 中选取，避免 source 在分区 0) ---
+    src_path = out_dir / f"{dataset_name}.sources"
+    print(f"  Writing default source list: {src_path}")
+    with open(src_path, 'w') as f:
+        count = 0
+        for vid in range(nvtxs):
+            if part[vid] > 0:
+                f.write(f"{vid}\n")
+                count += 1
+                if count >= 10:
+                    break
+    print(f"    Done ({count} sources, all in partitions > 0)")
+
+    print(f"\nDone! All files in {out_dir}/")
+    print(f"  {dataset_name}.intra.{{config,adj,idx}}  - intra-partition edges")
+    print(f"  {dataset_name}.inter.{{config,adj,idx}}  - inter-partition edges")
+    print(f"  {dataset_name}.part                   - partition file")
+    print(f"  {dataset_name}.sources                - source vertices")
+
+    np_arg = num_partitions + 1 if num_partitions >= 1 else 2  # +1 为空的 partition 0
+    if num_partitions >= 1:
