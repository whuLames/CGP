+        description='Convert CSR binary to Ligra binary format for ForkGraph')
+    parser.add_argument('datasets', nargs='+', help='Dataset names')
+    parser.add_argument('--csr-dir', default='/home/zyl/data/csr_data',
+                        help='Base directory for CSR data')
+    parser.add_argument('--out-dir', default=None,
+                        help='Output directory (default: ForkGraph/inputs_converted/)')
+    parser.add_argument('-n', '--num-partitions', type=int, default=1,
+                        help='Number of partitions (default: 1 = single partition)')
+    args = parser.parse_args()
+
+    csr_base = Path(args.csr_dir)
+
+    if args.out_dir:
+        out_base = Path(args.out_dir)
+    else:
+        out_base = Path(__file__).resolve().parent.parent / 'inputs_converted'
+
