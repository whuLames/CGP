new file mode 100644
index 0000000000000000000000000000000000000000..fd3163b9bd73d49f0ab8dc3dbcec6f51057dcffe
--- /dev/null
+++ b/tools/partition_gr_for_forkgraph.py
@@ -0,0 +1,446 @@
+#!/usr/bin/env python3
+"""Partition a Galois/Gunrock .gr graph for ForkGraph's -gr input path.
+
+The tool splits one .gr graph into:
+  <name>.inter.gr  cross-partition edges
+  <name>.intra.gr  same-partition edges
+  <name>.part      partition id for each original vertex
+  <name>.sources   default BFS/PPR source vertices
+
+Partitioning is range-based: part[v] = floor(v * P / nvtxs).  Vertices are
+not renumbered, which matches ForkGraph's current id2part[vertex_id] use.
+"""
+
+from __future__ import annotations
+
+import argparse
+import array
+import json
+import os
+import random
+import shutil
+import struct
+import sys
+import tempfile
+from pathlib import Path
+from typing import BinaryIO
+
+
+HEADER_STRUCT = struct.Struct("<QQQQ")
+I32_STRUCT = struct.Struct("<i")
+U64_STRUCT = struct.Struct("<Q")
+I64_STRUCT = struct.Struct("<q")
+READ_CHUNK_EDGES = 1 << 20
+
+
+class GGRFormatError(ValueError):
+    pass
+
+
+def _read_exact(f: BinaryIO, nbytes: int, label: str) -> bytes:
+    data = f.read(nbytes)
+    if len(data) != nbytes:
+        raise GGRFormatError(f"incomplete {label}: expected {nbytes} bytes, got {len(data)}")
+    return data
+
+
+def _array_from_file(typecode: str, f: BinaryIO, count: int, label: str) -> array.array:
+    values = array.array(typecode)
+    try:
+        values.fromfile(f, count)
+    except EOFError as exc:
+        raise GGRFormatError(f"incomplete {label}") from exc
+    if sys.byteorder != "little":
+        values.byteswap()
+    return values
+
+
+def _array_to_file(values: array.array, f: BinaryIO) -> None:
+    if sys.byteorder == "little":
+        values.tofile(f)
+        return
+    tmp = array.array(values.typecode, values)
+    tmp.byteswap()
+    tmp.tofile(f)
+
+
+def read_ggr_header(path: Path) -> tuple[int, int, int, int]:
+    with path.open("rb") as f:
+        data = _read_exact(f, HEADER_STRUCT.size, "GGR header")
+    version, size_edge_ty, nvtxs, nedges = HEADER_STRUCT.unpack(data)
+    if version != 1:
+        raise GGRFormatError(f"unsupported GGR version {version}; expected 1")
+    return version, size_edge_ty, nvtxs, nedges
+
+
+def validate_ggr_file_size(path: Path, nvtxs: int, nedges: int, size_edge_ty: int) -> None:
+    expected = HEADER_STRUCT.size + (nvtxs * 8) + (nedges * 4)
+    if size_edge_ty != 0:
+        expected += 4 if nedges % 2 else 0
+        # ForkGraph's GGR reader always consumes int32 weights when sizeEdgeTy != 0.
+        expected += nedges * 4
+    actual = path.stat().st_size
+    if actual != expected:
+        raise GGRFormatError(
+            f"{path} size mismatch: expected {expected} bytes from header/layout, got {actual}"
+        )
+
+
+def read_offsets(path: Path, nvtxs: int, nedges: int) -> array.array:
+    with path.open("rb") as f:
+        f.seek(HEADER_STRUCT.size)
+        row_start = _array_from_file("q", f, nvtxs, "GGR row_start")
+    offsets = array.array("q", [0])
+    offsets.extend(row_start)
+    if len(offsets) != nvtxs + 1:
+        raise GGRFormatError("bad row_start length")
+    prev = 0
+    for i, off in enumerate(offsets):
+        if off < prev:
+            raise GGRFormatError(f"row_start is not monotonic at offset index {i}")
+        if off > nedges:
+            raise GGRFormatError(f"row_start offset {off} exceeds edge count {nedges}")
+        prev = off
+    if offsets[-1] != nedges:
+        raise GGRFormatError(f"last row_start value {offsets[-1]} != nedges {nedges}")
+    return offsets
+
+
+def build_range_partitions(nvtxs: int, num_partitions: int) -> array.array:
+    if num_partitions < 1:
+        raise ValueError("--num-partitions must be >= 1")
+    if nvtxs < 1:
+        raise ValueError("input graph must have at least one vertex")
+    if num_partitions > nvtxs:
+        raise ValueError("--num-partitions must be <= number of vertices so every partition is non-empty")
+
+    part = array.array("i", (0 for _ in range(nvtxs)))
+    counts = [0] * num_partitions
+    for v in range(nvtxs):
+        p = (v * num_partitions) // nvtxs
+        part[v] = p
+        counts[p] += 1
+    if any(count == 0 for count in counts):
+        raise AssertionError("range partitioning produced an empty partition")
+    return part
+
+
+def _write_gr_header(f: BinaryIO, size_edge_ty: int, nvtxs: int, nedges: int) -> None:
+    f.write(HEADER_STRUCT.pack(1, size_edge_ty, nvtxs, nedges))
+
+
+def _copy_temp_to_final(temp_base: Path, final_path: Path, size_edge_ty: int, nvtxs: int,
+                        nedges: int, offsets_without_zero: array.array) -> None:
+    edge_tmp = temp_base.with_suffix(".edges.tmp")
+    weight_tmp = temp_base.with_suffix(".weights.tmp")
+    with final_path.open("wb") as out:
+        _write_gr_header(out, size_edge_ty, nvtxs, nedges)
+        _array_to_file(offsets_without_zero, out)
+        with edge_tmp.open("rb") as edge_in:
+            shutil.copyfileobj(edge_in, out, length=16 * 1024 * 1024)
+        if size_edge_ty != 0:
+            if nedges % 2:
+                out.write(b"\x00\x00\x00\x00")
+            with weight_tmp.open("rb") as weight_in:
+                shutil.copyfileobj(weight_in, out, length=16 * 1024 * 1024)
+
+
+def split_gr(input_path: Path, output_dir: Path, name: str, num_partitions: int,
+             source_count: int, verify: bool) -> dict:
+    version, size_edge_ty, nvtxs, nedges = read_ggr_header(input_path)
+    validate_ggr_file_size(input_path, nvtxs, nedges, size_edge_ty)
+    offsets = read_offsets(input_path, nvtxs, nedges)
+    part = build_range_partitions(nvtxs, num_partitions)
+
+    output_dir.mkdir(parents=True, exist_ok=True)
+    inter_path = output_dir / f"{name}.inter.gr"
+    intra_path = output_dir / f"{name}.intra.gr"
+    part_path = output_dir / f"{name}.part"
+    sources_path = output_dir / f"{name}.sources"
+    summary_path = output_dir / f"{name}.summary.json"
+
+    partition_stats = [
+        {"partition": p, "vertex_count": 0, "intra_edges": 0, "inter_edges": 0}
+        for p in range(num_partitions)
+    ]
+    for p in part:
+        partition_stats[p]["vertex_count"] += 1
+
+    inter_row = array.array("q", [0]) * nvtxs
+    intra_row = array.array("q", [0]) * nvtxs
+    nonisolated_by_part: list[int | None] = [None] * num_partitions
+    nonisolated_vertices: list[int] = []
+
+    edge_section_offset = HEADER_STRUCT.size + nvtxs * 8
+    weight_section_offset = edge_section_offset + nedges * 4
+    if size_edge_ty != 0 and nedges % 2:
+        weight_section_offset += 4
+
+    tmp_root = output_dir / f".{name}.partition-tmp"
+    with tempfile.TemporaryDirectory(prefix=tmp_root.name + "-", dir=output_dir) as tmp_dir_name:
+        tmp_dir = Path(tmp_dir_name)
+        inter_tmp = tmp_dir / "inter"
+        intra_tmp = tmp_dir / "intra"
+        inter_edges_tmp = inter_tmp.with_suffix(".edges.tmp")
+        intra_edges_tmp = intra_tmp.with_suffix(".edges.tmp")
+        inter_weights_tmp = inter_tmp.with_suffix(".weights.tmp")
+        intra_weights_tmp = intra_tmp.with_suffix(".weights.tmp")
+
+        inter_count = 0
+        intra_count = 0
+
+        with input_path.open("rb") as inp, \
+                inter_edges_tmp.open("wb") as inter_edges_out, \
+                intra_edges_tmp.open("wb") as intra_edges_out:
+            inter_weights_out = inter_weights_tmp.open("wb") if size_edge_ty != 0 else None
+            intra_weights_out = intra_weights_tmp.open("wb") if size_edge_ty != 0 else None
+            try:
+                for src in range(nvtxs):
+                    begin = offsets[src]
+                    end = offsets[src + 1]
+                    degree = end - begin
+                    src_part = part[src]
+                    if degree > 0:
+                        if nonisolated_by_part[src_part] is None:
+                            nonisolated_by_part[src_part] = src
+                        nonisolated_vertices.append(src)
+
+                    if degree == 0:
+                        inter_row[src] = inter_count
+                        intra_row[src] = intra_count
+                        continue
+
+                    inp.seek(edge_section_offset + begin * 4)
+                    dst_data = _read_exact(inp, degree * 4, f"edge_dst for vertex {src}")
+                    dst_values = array.array("i")
+                    dst_values.frombytes(dst_data)
+                    if sys.byteorder != "little":
+                        dst_values.byteswap()
+
+                    weight_data = None
+                    if size_edge_ty != 0:
+                        inp.seek(weight_section_offset + begin * 4)
+                        weight_data = _read_exact(inp, degree * 4, f"adjwgt for vertex {src}")
+
+                    inter_dst = array.array("i")
+                    intra_dst = array.array("i")
+                    inter_w = bytearray() if size_edge_ty != 0 else None
+                    intra_w = bytearray() if size_edge_ty != 0 else None
+
+                    for local_idx, dst in enumerate(dst_values):
+                        if dst < 0 or dst >= nvtxs:
+                            raise GGRFormatError(f"edge {src}->{dst} has destination outside [0, {nvtxs})")
+                        if part[dst] == src_part:
+                            intra_dst.append(dst)
+                            if intra_w is not None:
+                                start = local_idx * 4
+                                intra_w.extend(weight_data[start:start + 4])
+                        else:
+                            inter_dst.append(dst)
+                            if inter_w is not None:
+                                start = local_idx * 4
+                                inter_w.extend(weight_data[start:start + 4])
+
+                    if inter_dst:
+                        _array_to_file(inter_dst, inter_edges_out)
+                        if inter_weights_out is not None:
+                            inter_weights_out.write(inter_w)
+                    if intra_dst:
+                        _array_to_file(intra_dst, intra_edges_out)
+                        if intra_weights_out is not None:
+                            intra_weights_out.write(intra_w)
+
+                    inter_count += len(inter_dst)
+                    intra_count += len(intra_dst)
+                    inter_row[src] = inter_count
+                    intra_row[src] = intra_count
+                    partition_stats[src_part]["inter_edges"] += len(inter_dst)
+                    partition_stats[src_part]["intra_edges"] += len(intra_dst)
+            finally:
+                if inter_weights_out is not None:
+                    inter_weights_out.close()
+                if intra_weights_out is not None:
+                    intra_weights_out.close()
+
+        _copy_temp_to_final(inter_tmp, inter_path, size_edge_ty, nvtxs, inter_count, inter_row)
+        _copy_temp_to_final(intra_tmp, intra_path, size_edge_ty, nvtxs, intra_count, intra_row)
+
+    write_part_file(part_path, part)
+    sources = choose_sources(nonisolated_by_part, nonisolated_vertices, source_count)
+    write_sources_file(sources_path, sources)
+
+    summary = {
+        "input": str(input_path),
+        "nvtxs": nvtxs,
+        "nedges": nedges,
+        "num_partitions": num_partitions,
+        "sizeEdgeTy": size_edge_ty,
+        "inter_edges": inter_count,
+        "intra_edges": intra_count,
+        "partitions": partition_stats,
+        "outputs": {
+            "inter_gr": str(inter_path),
+            "intra_gr": str(intra_path),
+            "part": str(part_path),
+            "sources": str(sources_path),
+            "summary_json": str(summary_path),
+        },
+        "sources": sources,
+    }
+
+    if inter_count + intra_count != nedges:
+        raise AssertionError("split edge counts do not sum to original edge count")
+
+    if verify:
+        verify_outputs(input_path, inter_path, intra_path, part, nvtxs, nedges, size_edge_ty)
+        summary["verified"] = True
+
+    with summary_path.open("w") as f:
+        json.dump(summary, f, indent=2, sort_keys=True)
+        f.write("\n")
+
+    return summary
+
+
+def write_part_file(path: Path, part: array.array) -> None:
+    with path.open("w") as f:
+        for p in part:
+            f.write(f"{p}\n")
+
+
+def choose_sources(nonisolated_by_part: list[int | None], nonisolated_vertices: list[int],
+                   source_count: int) -> list[int]:
+    seen = set()
+    sources: list[int] = []
+
+    for src in nonisolated_by_part:
+        if src is not None and src not in seen:
+            sources.append(src)
+            seen.add(src)
+
+    for src in nonisolated_vertices:
+        if len(sources) >= source_count:
+            break
+        if src not in seen:
+            sources.append(src)
+            seen.add(src)
+
+    return sources
+
+
+def write_sources_file(path: Path, sources: list[int]) -> None:
+    with path.open("w") as f:
+        for src in sources:
+            f.write(f"{src}\n")
+
+
+def _read_one_edge(path: Path, nvtxs: int, edge_index: int) -> int:
+    edge_section_offset = HEADER_STRUCT.size + nvtxs * 8
+    with path.open("rb") as f:
+        f.seek(edge_section_offset + edge_index * 4)
+        return I32_STRUCT.unpack(_read_exact(f, 4, "sample edge"))[0]
+
+
+def _sample_edges(path: Path, offsets: array.array, sample_limit: int) -> list[tuple[int, int]]:
+    _, _, nvtxs, nedges = read_ggr_header(path)
+    if nedges == 0:
+        return []
+    samples: list[tuple[int, int]] = []
+    probe_count = min(sample_limit, nedges)
+    rng = random.Random(1)
+    edge_indices = sorted(rng.sample(range(nedges), probe_count))
+    src = 0
+    for edge_idx in edge_indices:
+        while src + 1 < len(offsets) and offsets[src + 1] <= edge_idx:
+            src += 1
+        samples.append((src, _read_one_edge(path, nvtxs, edge_idx)))
+    return samples
+
+
+def verify_outputs(input_path: Path, inter_path: Path, intra_path: Path, part: array.array,
+                   nvtxs: int, nedges: int, size_edge_ty: int) -> None:
+    _, inter_size_edge_ty, inter_n, inter_m = read_ggr_header(inter_path)
+    _, intra_size_edge_ty, intra_n, intra_m = read_ggr_header(intra_path)
+    if inter_n != nvtxs or intra_n != nvtxs:
+        raise AssertionError("output nvtxs does not match input")
+    if inter_size_edge_ty != size_edge_ty or intra_size_edge_ty != size_edge_ty:
+        raise AssertionError("output sizeEdgeTy does not match input")
+    if inter_m + intra_m != nedges:
+        raise AssertionError("verified edge counts do not sum to original")
+    validate_ggr_file_size(inter_path, inter_n, inter_m, inter_size_edge_ty)
+    validate_ggr_file_size(intra_path, intra_n, intra_m, intra_size_edge_ty)
+
+    inter_offsets = read_offsets(inter_path, inter_n, inter_m)
+    intra_offsets = read_offsets(intra_path, intra_n, intra_m)
+    for src, dst in _sample_edges(inter_path, inter_offsets, 1000):
+        if part[src] == part[dst]:
+            raise AssertionError(f"inter sample {src}->{dst} is same-partition")
+    for src, dst in _sample_edges(intra_path, intra_offsets, 1000):
+        if part[src] != part[dst]:
+            raise AssertionError(f"intra sample {src}->{dst} is cross-partition")
+
+    if len(set(part)) == 1:
+        if inter_m != 0 or intra_m != nedges:
+            raise AssertionError("P=1 regression check failed")
+
+
+def parse_args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser(
+        description="Split a Galois/Gunrock .gr graph into ForkGraph inter/intra .gr inputs."
+    )
+    parser.add_argument("--input", required=True, type=Path, help="Input .gr file")
+    parser.add_argument("--output-dir", required=True, type=Path, help="Directory for generated files")
+    parser.add_argument("--name", default=None, help="Output basename (default: input stem)")
+    parser.add_argument("-p", "--num-partitions", required=True, type=int, help="Number of range partitions")
+    parser.add_argument("--source-count", type=int, default=10, help="Minimum default source count to try")
+    parser.add_argument("--verify", action="store_true", help="Verify output headers/counts and sample edge classes")
+    return parser.parse_args()
+
+
+def main() -> int:
+    args = parse_args()
+    input_path = args.input.resolve()
+    if not input_path.exists():
+        print(f"ERROR: input file not found: {input_path}", file=sys.stderr)
+        return 2
+    if args.source_count < 1:
+        print("ERROR: --source-count must be >= 1", file=sys.stderr)
+        return 2
+
+    name = args.name or input_path.stem
+    try:
+        summary = split_gr(
+            input_path=input_path,
+            output_dir=args.output_dir,
+            name=name,
+            num_partitions=args.num_partitions,
+            source_count=args.source_count,
+            verify=args.verify,
+        )
+    except Exception as exc:
+        print(f"ERROR: {exc}", file=sys.stderr)
+        return 1
+
+    print(f"Input:       {summary['input']}")
+    print(f"Vertices:    {summary['nvtxs']:,}")
+    print(f"Edges:       {summary['nedges']:,}")
+    print(f"Partitions:  {summary['num_partitions']}")
+    print(f"Inter edges: {summary['inter_edges']:,}")
+    print(f"Intra edges: {summary['intra_edges']:,}")
+    print("Outputs:")
+    for key, value in summary["outputs"].items():
+        print(f"  {key}: {value}")
+    print()
+    print("ForkGraph command:")
+    print(
+        f"  ./bfs -gr -p {summary['num_partitions']} "
+        f"{summary['outputs']['sources']} "
+        f"{summary['outputs']['inter_gr']} "
+        f"{summary['outputs']['intra_gr']} "
+        f"{summary['outputs']['part']}"
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
