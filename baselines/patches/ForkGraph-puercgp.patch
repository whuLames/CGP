+#include <algorithm>
+#include <cerrno>
+#include <cstdint>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <iostream>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+#include <fcntl.h>
+#include <omp.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+namespace fs = std::filesystem;
+
+namespace {
+
+struct GrHeader {
+  std::uint64_t version;
+  std::uint64_t size_edge_ty;
+  std::uint64_t vertices;
+  std::uint64_t edges;
+};
+
+static_assert(sizeof(GrHeader) == 32);
+
+class MappedFile {
+ public:
+  MappedFile(const fs::path& path, int flags, int prot, std::uint64_t size = 0)
+      : path_(path), size_(size) {
+    fd_ = ::open(path.c_str(), flags, 0644);
+    if (fd_ < 0) {
+      throw std::runtime_error("open failed for " + path.string() + ": " +
+                               std::strerror(errno));
+    }
+    if ((flags & O_RDWR) != 0 && ::ftruncate(fd_, static_cast<off_t>(size_)) != 0) {
+      throw std::runtime_error("ftruncate failed for " + path.string() + ": " +
+                               std::strerror(errno));
+    }
+    if (size_ == 0) {
+      struct stat st {};
+      if (::fstat(fd_, &st) != 0) {
+        throw std::runtime_error("fstat failed for " + path.string());
+      }
+      size_ = static_cast<std::uint64_t>(st.st_size);
+    }
+    data_ = ::mmap(nullptr, size_, prot, MAP_SHARED, fd_, 0);
+    if (data_ == MAP_FAILED) {
+      data_ = nullptr;
+      throw std::runtime_error("mmap failed for " + path.string() + ": " +
+                               std::strerror(errno));
+    }
+  }
+
+  MappedFile(const MappedFile&) = delete;
+  MappedFile& operator=(const MappedFile&) = delete;
+
+  ~MappedFile() {
+    if (data_ != nullptr) {
+      ::munmap(data_, size_);
+    }
+    if (fd_ >= 0) {
+      ::close(fd_);
+    }
+  }
+
+  void sync() {
+    if (::msync(data_, size_, MS_SYNC) != 0) {
+      throw std::runtime_error("msync failed for " + path_.string() + ": " +
+                               std::strerror(errno));
+    }
+  }
+
+  void* data() { return data_; }
+  const void* data() const { return data_; }
+  std::uint64_t size() const { return size_; }
+
+ private:
+  fs::path path_;
+  int fd_ = -1;
+  void* data_ = nullptr;
+  std::uint64_t size_ = 0;
+};
+
+std::uint64_t gr_size(std::uint64_t vertices, std::uint64_t edges,
+                      bool weighted) {
+  std::uint64_t size = sizeof(GrHeader) + vertices * sizeof(std::uint64_t) +
+                       edges * sizeof(std::int32_t);
+  if (weighted) {
+    size += (edges & 1U) ? sizeof(std::int32_t) : 0;
+    size += edges * sizeof(std::int32_t);
+  }
+  return size;
+}
+
+struct GrView {
+  const GrHeader* header;
+  const std::uint64_t* row_end;
+  const std::int32_t* destinations;
+  const std::int32_t* weights;
+};
+
+GrView view_input(const MappedFile& input) {
+  const auto* bytes = static_cast<const std::uint8_t*>(input.data());
+  if (input.size() < sizeof(GrHeader)) {
+    throw std::runtime_error("input is smaller than a GR header");
+  }
+  const auto* header = reinterpret_cast<const GrHeader*>(bytes);
+  if (header->version != 1) {
+    throw std::runtime_error("unsupported GR version " +
+                             std::to_string(header->version));
+  }
+  const bool weighted = header->size_edge_ty != 0;
+  const auto expected = gr_size(header->vertices, header->edges, weighted);
+  if (input.size() != expected) {
+    throw std::runtime_error("input size mismatch: expected " +
+                             std::to_string(expected) + ", got " +
+                             std::to_string(input.size()));
+  }
+
+  const auto* row_end = reinterpret_cast<const std::uint64_t*>(
+      bytes + sizeof(GrHeader));
+  const auto* destinations = reinterpret_cast<const std::int32_t*>(
+      bytes + sizeof(GrHeader) + header->vertices * sizeof(std::uint64_t));
+  const std::int32_t* weights = nullptr;
+  if (weighted) {
+    const auto padding = (header->edges & 1U) ? sizeof(std::int32_t) : 0;
+    weights = reinterpret_cast<const std::int32_t*>(
+        reinterpret_cast<const std::uint8_t*>(destinations + header->edges) +
+        padding);
+  }
+  return {header, row_end, destinations, weights};
+}
+
+struct MutableGrView {
+  GrHeader* header;
+  std::uint64_t* row_end;
+  std::int32_t* destinations;
+  std::int32_t* weights;
+};
+
+MutableGrView initialize_output(MappedFile& output, std::uint64_t vertices,
+                                std::uint64_t edges, std::uint64_t size_edge_ty) {
+  auto* bytes = static_cast<std::uint8_t*>(output.data());
+  auto* header = reinterpret_cast<GrHeader*>(bytes);
+  *header = {1, size_edge_ty, vertices, edges};
+  auto* row_end = reinterpret_cast<std::uint64_t*>(bytes + sizeof(GrHeader));
+  auto* destinations = reinterpret_cast<std::int32_t*>(
+      bytes + sizeof(GrHeader) + vertices * sizeof(std::uint64_t));
+  std::int32_t* weights = nullptr;
+  if (size_edge_ty != 0) {
+    const auto padding = (edges & 1U) ? sizeof(std::int32_t) : 0;
+    if (padding != 0) {
+      std::memset(destinations + edges, 0, padding);
+    }
+    weights = reinterpret_cast<std::int32_t*>(
+        reinterpret_cast<std::uint8_t*>(destinations + edges) + padding);
+  }
+  return {header, row_end, destinations, weights};
+}
+
+std::vector<std::uint32_t> build_partitions(const GrView& source,
+                                            std::uint64_t target_bytes) {
+  std::vector<std::uint32_t> part(source.header->vertices);
+  std::uint32_t current_part = 0;
+  std::uint64_t current_bytes = 0;
+  const auto edge_bytes = source.header->size_edge_ty != 0
+                              ? 2 * sizeof(std::int32_t)
+                              : sizeof(std::int32_t);
+  for (std::uint64_t src = 0; src < source.header->vertices; ++src) {
+    const auto begin = src == 0 ? 0 : source.row_end[src - 1];
+    const auto end = source.row_end[src];
+    const auto row_bytes = 2 * sizeof(std::uint64_t) + (end - begin) * edge_bytes;
+    if (current_bytes != 0 && current_bytes + row_bytes > target_bytes) {
+      ++current_part;
+      current_bytes = 0;
+    }
+    part[src] = current_part;
+    current_bytes += row_bytes;
+  }
+  return part;
+}
+
+void write_partitions(const fs::path& path,
+                      const std::vector<std::uint32_t>& part) {
+  std::ofstream out(path);
+  if (!out) {
+    throw std::runtime_error("cannot create " + path.string());
+  }
+  std::string buffer;
+  buffer.reserve(1U << 20);
+  for (const auto partition : part) {
+    buffer.append(std::to_string(partition));
+    buffer.push_back('\n');
+    if (buffer.size() >= (1U << 20)) {
+      out.write(buffer.data(), static_cast<std::streamsize>(buffer.size()));
+      buffer.clear();
+    }
+  }
+  out.write(buffer.data(), static_cast<std::streamsize>(buffer.size()));
+}
+
+}  // namespace
+
+int main(int argc, char** argv) try {
+  if (argc != 6) {
+    std::cerr << "Usage: " << argv[0]
+              << " <input.gr> <output-dir> <name> <target-mib> <threads>\n";
+    return 2;
+  }
+
+  const fs::path input_path = argv[1];
+  const fs::path output_dir = argv[2];
+  const std::string name = argv[3];
+  const double target_mib = std::stod(argv[4]);
+  const int threads = std::stoi(argv[5]);
+  if (target_mib <= 0 || threads <= 0) {
+    throw std::runtime_error("target-mib and threads must be positive");
+  }
+  omp_set_dynamic(0);
+  omp_set_num_threads(threads);
+  fs::create_directories(output_dir);
+
+  MappedFile input(input_path, O_RDONLY, PROT_READ);
+  const auto source = view_input(input);
+  const auto vertices = source.header->vertices;
+  const auto edges = source.header->edges;
+  const bool weighted = source.header->size_edge_ty != 0;
+  const auto target_bytes = static_cast<std::uint64_t>(
+      target_mib * 1024.0 * 1024.0);
+  const auto part_of_vertex = build_partitions(source, target_bytes);
+  const auto partitions = part_of_vertex.back() + 1;
+
+  std::vector<std::uint64_t> intra_degree(vertices);
+  std::vector<std::uint64_t> inter_degree(vertices);
+
+  const double classify_start = omp_get_wtime();
+#pragma omp parallel for schedule(dynamic, 256)
+  for (std::uint64_t src = 0; src < vertices; ++src) {
+    const auto begin = src == 0 ? 0 : source.row_end[src - 1];
+    const auto end = source.row_end[src];
+    const auto src_part = part_of_vertex[src];
+    std::uint64_t intra = 0;
+    for (auto edge = begin; edge < end; ++edge) {
+      const auto dst = static_cast<std::uint32_t>(source.destinations[edge]);
+      if (dst >= vertices) {
+        continue;
+      }
+      intra += part_of_vertex[dst] == src_part;
+    }
+    intra_degree[src] = intra;
+    inter_degree[src] = end - begin - intra;
+  }
+
+  std::uint64_t intra_edges = 0;
+  std::uint64_t inter_edges = 0;
+  std::vector<std::uint64_t> partition_vertices(partitions);
+  std::vector<std::uint64_t> partition_intra(partitions);
+  std::vector<std::uint64_t> partition_inter(partitions);
+  for (std::uint64_t src = 0; src < vertices; ++src) {
+    intra_edges += intra_degree[src];
+    inter_edges += inter_degree[src];
+    const auto part = part_of_vertex[src];
+    ++partition_vertices[part];
+    partition_intra[part] += intra_degree[src];
+    partition_inter[part] += inter_degree[src];
+    intra_degree[src] = intra_edges;
+    inter_degree[src] = inter_edges;
+  }
+  if (intra_edges + inter_edges != edges) {
+    throw std::runtime_error("classified edge counts do not match input");
+  }
+  const double classify_seconds = omp_get_wtime() - classify_start;
+
+  const fs::path intra_path = output_dir / (name + ".intra.gr");
+  const fs::path inter_path = output_dir / (name + ".inter.gr");
+  MappedFile intra_file(intra_path, O_RDWR | O_CREAT | O_TRUNC, PROT_READ | PROT_WRITE,
+                        gr_size(vertices, intra_edges, weighted));
+  MappedFile inter_file(inter_path, O_RDWR | O_CREAT | O_TRUNC, PROT_READ | PROT_WRITE,
+                        gr_size(vertices, inter_edges, weighted));
+  auto intra = initialize_output(intra_file, vertices, intra_edges,
+                                 source.header->size_edge_ty);
+  auto inter = initialize_output(inter_file, vertices, inter_edges,
+                                 source.header->size_edge_ty);
+  std::copy(intra_degree.begin(), intra_degree.end(), intra.row_end);
+  std::copy(inter_degree.begin(), inter_degree.end(), inter.row_end);
+
+  const double scatter_start = omp_get_wtime();
+#pragma omp parallel for schedule(dynamic, 256)
+  for (std::uint64_t src = 0; src < vertices; ++src) {
+    const auto begin = src == 0 ? 0 : source.row_end[src - 1];
+    const auto end = source.row_end[src];
+    auto intra_pos = src == 0 ? 0 : intra.row_end[src - 1];
+    auto inter_pos = src == 0 ? 0 : inter.row_end[src - 1];
+    const auto src_part = part_of_vertex[src];
+    for (auto edge = begin; edge < end; ++edge) {
+      const auto dst = source.destinations[edge];
+      const bool is_intra = dst >= 0 && static_cast<std::uint64_t>(dst) < vertices &&
+                            part_of_vertex[static_cast<std::uint32_t>(dst)] == src_part;
+      auto& output = is_intra ? intra : inter;
+      auto& position = is_intra ? intra_pos : inter_pos;
+      output.destinations[position] = dst;
+      if (weighted) {
+        output.weights[position] = source.weights[edge];
+      }
+      ++position;
+    }
+  }
+  const double scatter_seconds = omp_get_wtime() - scatter_start;
+
+  intra_file.sync();
+  inter_file.sync();
+  write_partitions(output_dir / (name + ".part"), part_of_vertex);
+
+  std::uint64_t max_partition_bytes = 0;
+  for (std::uint32_t part = 0; part < partitions; ++part) {
+    const auto bytes = partition_vertices[part] * 2 * sizeof(std::uint64_t) +
+                       (partition_intra[part] + partition_inter[part]) *
+                           (weighted ? 2 : 1) * sizeof(std::int32_t);
+    max_partition_bytes = std::max(max_partition_bytes, bytes);
+  }
+
+  const fs::path summary_path = output_dir / (name + ".summary.json");
+  std::ofstream summary(summary_path);
+  summary << "{\n"
+          << "  \"input\": \"" << input_path.string() << "\",\n"
+          << "  \"vertices\": " << vertices << ",\n"
+          << "  \"edges\": " << edges << ",\n"
+          << "  \"partitions\": " << partitions << ",\n"
+          << "  \"partition_method\": \"contiguous_edge_balanced_range\",\n"
+          << "  \"target_partition_mib\": " << target_mib << ",\n"
+          << "  \"intra_edges\": " << intra_edges << ",\n"
+          << "  \"inter_edges\": " << inter_edges << ",\n"
+          << "  \"max_partition_bytes\": " << max_partition_bytes << ",\n"
+          << "  \"classify_seconds\": " << classify_seconds << ",\n"
+          << "  \"scatter_seconds\": " << scatter_seconds << "\n"
+          << "}\n";
+
+  std::cout << "DONE name=" << name << " vertices=" << vertices
+            << " edges=" << edges << " partitions=" << partitions
+            << " intra_edges=" << intra_edges << " inter_edges=" << inter_edges
+            << " max_partition_mib="
+            << static_cast<double>(max_partition_bytes) / (1024.0 * 1024.0)
+            << " classify_s=" << classify_seconds
+            << " scatter_s=" << scatter_seconds << '\n';
+  return 0;
+} catch (const std::exception& error) {
+  std::cerr << "ERROR: " << error.what() << '\n';
+  return 1;
+}
