+    cout << "Unable to open GGR file: " << iFile << endl;
+    abort();
+  }
+
+  uint64_t version, sizeEdgeTy, nvtxs64, nedges64;
+  infile.read((char *) &version, sizeof(uint64_t));
+  infile.read((char *) &sizeEdgeTy, sizeof(uint64_t));
+  infile.read((char *) &nvtxs64, sizeof(uint64_t));
+  infile.read((char *) &nedges64, sizeof(uint64_t));
+  if (!infile || version != 1) {
+    cout << "Bad or unsupported GGR file: " << iFile << endl;
+    abort();
+  }
+
+  long n = (long) nvtxs64;
+  long m = (long) nedges64;
+  uintT *offsets = newA(uintT, n + 1);
+  offsets[0] = 0;
+  int64_t *rowStart = newA(int64_t, n);
+  infile.read((char *) rowStart, sizeof(int64_t) * n);
+  if (!infile) {
+    cout << "Incomplete GGR row_start section: " << iFile << endl;
+    abort();
+  }
+  { parallel_for (long i = 0; i < n; i++) offsets[i + 1] = (uintT) rowStart[i]; }
+  free(rowStart);
+
+  int32_t *dst = newA(int32_t, m);
+  infile.read((char *) dst, sizeof(int32_t) * m);
+  if (!infile) {
+    cout << "Incomplete GGR edge_dst section: " << iFile << endl;
+    abort();
+  }
+
+#ifdef WEIGHTED
+  int32_t *wgt = nullptr;
+  if (sizeEdgeTy != 0) {
+    if (m % 2 == 1) infile.seekg(4, ios::cur);
+    wgt = newA(int32_t, m);
+    infile.read((char *) wgt, sizeof(int32_t) * m);
+    if (!infile) {
+      cout << "Incomplete GGR adjwgt section: " << iFile << endl;
+      abort();
+    }
+  }
+  intE *edgesAndWeights = newA(intE, 2 * m);
+  {
+    parallel_for (long i = 0; i < m; i++) {
+      edgesAndWeights[2 * i] = (intE) dst[i];
+      edgesAndWeights[2 * i + 1] = (sizeEdgeTy != 0) ? (intE) wgt[i] : 1;
+    }
+  }
+  if (wgt != nullptr) free(wgt);
+  free(dst);
+#else
+  uintE *edges = newA(uintE, m);
+  { parallel_for (long i = 0; i < m; i++) edges[i] = (uintE) dst[i]; }
+  free(dst);
+#endif
+
+  vertex *v = newA(vertex, n);
+  {
+    parallel_for (long i = 0; i < n; i++) {
+      uintT o = offsets[i];
+      uintT l = ((i == n - 1) ? m : offsets[i + 1]) - offsets[i];
+      v[i].setOutDegree(l);
+#ifndef WEIGHTED
+      v[i].setOutNeighbors(edges + o);
+#else
+      v[i].setOutNeighbors(edgesAndWeights + 2 * o);
+#endif
+    }
+  }
+
+  if (m == 0) {
+    parallel_for (long i = 0; i < n; i++) {
+      v[i].setInDegree(0);
+      v[i].setInNeighbors(nullptr);
+    }
+    free(offsets);
+#ifndef WEIGHTED
+    Uncompressed_Mem<vertex> *mem = new Uncompressed_Mem<vertex>(v, n, 0, edges);
+#else
+    Uncompressed_Mem<vertex> *mem = new Uncompressed_Mem<vertex>(v, n, 0, edgesAndWeights);
+#endif
+    return graph<vertex>(v, n, 0, mem);
+  }
+
+  if (!isSymmetric) {
+    uintT *tOffsets = newA(uintT, n);
+    { parallel_for (long i = 0; i < n; i++) tOffsets[i] = INT_T_MAX; }
+#ifndef WEIGHTED
+    intPair *temp = newA(intPair, m);
+#else
+    intTriple *temp = newA(intTriple, m);
+#endif
+    {
+      parallel_for (intT i = 0; i < n; i++) {
+        uintT o = offsets[i];
+        for (uintT j = 0; j < v[i].getOutDegree(); j++) {
+#ifndef WEIGHTED
+          temp[o + j] = make_pair(v[i].getOutNeighbor(j), i);
+#else
+          temp[o + j] = make_pair(v[i].getOutNeighbor(j), make_pair(i, v[i].getOutWeight(j)));
+#endif
+        }
+      }
+    }
+    free(offsets);
+#ifndef WEIGHTED
+#ifndef LOWMEM
+    intSort::iSort(temp, m, n + 1, getFirst<uintE>());
+#else
+    quickSort(temp, m, pairFirstCmp<uintE>());
+#endif
+#else
+#ifndef LOWMEM
+    intSort::iSort(temp, m, n + 1, getFirst<intPair>());
+#else
+    quickSort(temp, m, pairFirstCmp<intPair>());
+#endif
+#endif
+    tOffsets[temp[0].first] = 0;
+#ifndef WEIGHTED
+    uintE *inEdges = newA(uintE, m);
+    inEdges[0] = temp[0].second;
+#else
+    intE *inEdges = newA(intE, 2 * m);
+    inEdges[0] = temp[0].second.first;
+    inEdges[1] = temp[0].second.second;
+#endif
+    {
+      parallel_for (long i = 1; i < m; i++) {
+#ifndef WEIGHTED
+        inEdges[i] = temp[i].second;
+#else
+        inEdges[2 * i] = temp[i].second.first;
+        inEdges[2 * i + 1] = temp[i].second.second;
+#endif
+        if (temp[i].first != temp[i - 1].first) tOffsets[temp[i].first] = i;
+      }
+    }
+    free(temp);
+    sequence::scanIBack(tOffsets, tOffsets, n, minF<uintT>(), (uintT) m);
+    {
+      parallel_for (long i = 0; i < n; i++) {
+        uintT o = tOffsets[i];
+        uintT l = ((i == n - 1) ? m : tOffsets[i + 1]) - tOffsets[i];
+        v[i].setInDegree(l);
+#ifndef WEIGHTED
+        v[i].setInNeighbors(inEdges + o);
+#else
+        v[i].setInNeighbors((intE *) (inEdges + 2 * o));
+#endif
+      }
+    }
+    free(tOffsets);
+#ifndef WEIGHTED
+    Uncompressed_Mem<vertex> *mem = new Uncompressed_Mem<vertex>(v, n, m, edges, inEdges);
+#else
+    Uncompressed_Mem<vertex> *mem = new Uncompressed_Mem<vertex>(v, n, m, edgesAndWeights, inEdges);
+#endif
+    return graph<vertex>(v, n, m, mem);
+  }
+
+  free(offsets);
+#ifndef WEIGHTED
+  Uncompressed_Mem<vertex> *mem = new Uncompressed_Mem<vertex>(v, n, m, edges);
+#else
+  Uncompressed_Mem<vertex> *mem = new Uncompressed_Mem<vertex>(v, n, m, edgesAndWeights);
+#endif
+  return graph<vertex>(v, n, m, mem);
+}
+
+template<class vertex>
+graph<vertex> readGraph(char *iFile, bool compressed, bool symmetric, bool binary, bool mmap, bool gr = false) {
+  if (gr) return readGraphFromGGR<vertex>(iFile, symmetric);
   if (binary) return readGraphFromBinary<vertex>(iFile, symmetric);
   else return readGraphFromFile<vertex>(iFile, symmetric, mmap);
 }
