+	if(file==NULL)
+	{
+		std::cout<<gr_file<<" cannot open\n";
+		exit(-1);
+	}
+
+	size_t ret=fread(header, sizeof(uint64_t), 4, file);
+	if(ret!=4)
+	{
+		std::cout<<gr_file<<" has an incomplete .gr header\n";
+		fclose(file);
+		exit(-1);
+	}
+
+	const uint64_t version=header[0];
+	const uint64_t size_edge_ty=header[1];
+	const uint64_t nvtxs=header[2];
+	const uint64_t nedges=header[3];
+
+	if(version!=1)
+	{
+		std::cout<<gr_file<<" has unsupported .gr version "<<version<<"\n";
+		fclose(file);
+		exit(-1);
+	}
+	if(nvtxs>static_cast<uint64_t>(std::numeric_limits<index_t>::max()) ||
+			nedges>static_cast<uint64_t>(std::numeric_limits<index_t>::max()))
+	{
+		std::cout<<gr_file<<" is too large for this iBFS build "
+			<<"(index_t/vertex_t are 32-bit signed integers)\n";
+		fclose(file);
+		exit(-1);
+	}
+
+	src_list = new vertex_t[src_count];
+	vert_count=static_cast<index_t>(nvtxs);
+	edge_count=static_cast<index_t>(nedges);
+	beg_pos = new index_t[vert_count+1];
+	csr = new vertex_t[edge_count];
+
+	beg_pos[0]=0;
+	const uint64_t chunk_entries=1<<20;
+	uint64_t *tmp_beg_pos = new uint64_t[chunk_entries];
+	uint64_t last_offset=0;
+	for(uint64_t done=0; done<nvtxs; )
+	{
+		uint64_t batch=nvtxs-done;
+		if(batch>chunk_entries)
+			batch=chunk_entries;
+		ret=fread(tmp_beg_pos, sizeof(uint64_t), batch, file);
+		if(ret!=batch)
+		{
+			std::cout<<gr_file<<" ended while reading .gr row_start\n";
+			delete[] tmp_beg_pos;
+			fclose(file);
+			exit(-1);
+		}
+		for(uint64_t i=0;i<batch;++i)
+		{
+			if(tmp_beg_pos[i]>static_cast<uint64_t>(std::numeric_limits<index_t>::max()))
+			{
+				std::cout<<gr_file<<" has a row_start offset too large for index_t\n";
+				delete[] tmp_beg_pos;
+				fclose(file);
+				exit(-1);
+			}
+			if(tmp_beg_pos[i]<last_offset || tmp_beg_pos[i]>nedges)
+			{
+				std::cout<<gr_file<<" has an invalid .gr row_start offset\n";
+				delete[] tmp_beg_pos;
+				fclose(file);
+				exit(-1);
+			}
+			beg_pos[done+i+1]=static_cast<index_t>(tmp_beg_pos[i]);
+			last_offset=tmp_beg_pos[i];
+		}
+		done+=batch;
+	}
+	delete[] tmp_beg_pos;
+
+	if(beg_pos[vert_count]!=edge_count)
+	{
+		std::cout<<gr_file<<" row_start last entry "<<beg_pos[vert_count]
+			<<" does not match header edge count "<<edge_count<<"\n";
+		fclose(file);
+		exit(-1);
+	}
+
+	const uint64_t edge_chunk_entries=1<<20;
+	uint32_t *tmp_csr = new uint32_t[edge_chunk_entries];
+	for(uint64_t done=0; done<nedges; )
+	{
+		uint64_t batch=nedges-done;
+		if(batch>edge_chunk_entries)
+			batch=edge_chunk_entries;
+		ret=fread(tmp_csr, sizeof(uint32_t), batch, file);
+		if(ret!=batch)
+		{
+			std::cout<<gr_file<<" ended while reading .gr edge_dst\n";
+			delete[] tmp_csr;
+			fclose(file);
+			exit(-1);
+		}
+		for(uint64_t i=0;i<batch;++i)
+		{
+			if(tmp_csr[i]>=nvtxs)
+			{
+				std::cout<<gr_file<<" has an edge destination outside vertex range\n";
+				delete[] tmp_csr;
+				fclose(file);
+				exit(-1);
+			}
+			csr[done+i]=static_cast<vertex_t>(tmp_csr[i]);
+		}
+		done+=batch;
+	}
+	delete[] tmp_csr;
+
+	fclose(file);
+
+	std::cout<<"Graph load (success): "<<vert_count<<" verts, "
+		<<edge_count<<" edges from .gr";
+	if(size_edge_ty!=0)
+		std::cout<<" (ignored edge data type size "<<size_edge_ty<<")";
+	std::cout<<" "<<wtime()-tm<<" second(s)\n";
+}
