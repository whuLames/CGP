+#!/bin/bash
+# iBFS benchmark script
+# Usage: bash run_bench.sh > bench_results.log 2>&1
+cd "$(dirname "$0")"
+
+run_test() {
+    local DATASET=$1
+    local BEG=$2
+    local CSR=$3
+    local CONC=$4
+    local LABEL="${DATASET}_c${CONC}"
+    echo "===== ${LABEL} ====="
+    timeout 600 mpirun --allow-run-as-root -np 1 ./gpu-ibfs "$BEG" "$CSR" "$CONC" 8 "$CONC" 2>&1
+    echo ""
+}
+
+# cit-Patents: 3.8M verts, 33M edges
+CIT_BEG="/home/zyl/data/csr_data/cit-Patents/cit-Patents_beg_pos.bin"
+CIT_CSR="/home/zyl/data/csr_data/cit-Patents/cit-Patents_csr.bin"
+
+# soc-orkut: 3.0M verts, 213M edges
+ORK_BEG="/home/zyl/data/csr_data/soc-orkut/soc-orkut_beg_pos.bin"
+ORK_CSR="/home/zyl/data/csr_data/soc-orkut/soc-orkut_csr.bin"
+
+# soc-sinaweibo_rabbit: 58.7M verts, 523M edges
+SW_BEG="/home/zyl/data/csr_data/soc-sinaweibo_rabbit/soc-sinaweibo_rabbit_beg_pos.bin"
+SW_CSR="/home/zyl/data/csr_data/soc-sinaweibo_rabbit/soc-sinaweibo_rabbit_csr.bin"
+
+# soc-twitter: 21.3M verts, 530M edges
+TW_BEG="/home/zyl/data/csr_data/soc-twitter/soc-twitter_beg_pos.bin"
+TW_CSR="/home/zyl/data/csr_data/soc-twitter/soc-twitter_csr.bin"
+
+for C in 2 4 8 16 32 64; do
+    run_test cit-Patents "$CIT_BEG" "$CIT_CSR" "$C"
+done
+
+for C in 2 4 8 16 32 64; do
+    run_test soc-orkut "$ORK_BEG" "$ORK_CSR" "$C"
+done
+
+for C in 2 4 8 16 32 64; do
+    run_test soc-sinaweibo "$SW_BEG" "$SW_CSR" "$C"
+done
+
+for C in 2 4 8 16 32 64; do
+    run_test soc-twitter "$TW_BEG" "$TW_CSR" "$C"
+done
