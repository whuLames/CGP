@inproceedings{mazloumi_multilyra_2019,
	location = {Los Angeles, {CA}, {USA}},
	title = {{MultiLyra}: Scalable Distributed Evaluation of Batches of Iterative Graph Queries},
	rights = {https://ieeexplore.ieee.org/Xplorehelp/downloads/license-information/{IEEE}.html},
	isbn = {978-1-7281-0858-2},
	url = {https://ieeexplore.ieee.org/document/9006359/},
	doi = {10.1109/BigData47090.2019.9006359},
	shorttitle = {{MultiLyra}},
	abstract = {Graph analytics is being increasingly used for analyzing large scale networks representing entities and relationships in many domains. Various distributed graph processing frameworks have been developed to deliver scalable performance for evaluation of individual iterative graph queries. In practice though, we may need to evaluate many queries. In this paper we develop {MultiLyra}, a distributed framework that efﬁciently evaluates a batch of graph queries. To deliver high performance, this system is designed to amortize the communication and synchronization costs of distributed query evaluation across multiple queries. Our experiments with {MultiLyra} for four iterative algorithms on a cluster of four 32-core machines show the following. Basic batching technique for amortizing communication and synchronization costs yield maximum speedups ranging from 3.08× to 5.55× across different batch sizes, algorithms and input graphs. After employing optimizations that improve scalability of expensive phases and perform reuse across the distributed computation, the improved maximum speedups range from 7.35× to 11.86×. {MultiLyra} also delivers superior scalabilty than the Quegel batch processing system.},
	eventtitle = {2019 {IEEE} International Conference on Big Data (Big Data)},
	pages = {349--358},
	booktitle = {2019 {IEEE} International Conference on Big Data (Big Data)},
	publisher = {{IEEE}},
	author = {Mazloumi, Abbas and Jiang, Xiaolin and Gupta, Rajiv},
	urldate = {2026-05-11},
	date = {2019-12},
	langid = {english},
	file = {PDF:/Users/zyl/Zotero/storage/Y4DK8L7T/Mazloumi 等 - 2019 - MultiLyra Scalable Distributed Evaluation of Batches of Iterative Graph Queries.pdf:application/pdf},
}

@article{wang_concurrent_2014,
	title = {Concurrent analytical query processing with {GPUs}},
	volume = {7},
	issn = {2150-8097},
	url = {https://dl.acm.org/doi/10.14778/2732967.2732976},
	doi = {10.14778/2732967.2732976},
	abstract = {In current databases, {GPUs} are used as dedicated accelerators to process each individual query. Sharing {GPUs} among concurrent queries is not supported, causing serious resource underutilization. Based on the profiling of an open-source {GPU} query engine running commonly used single-query data warehousing workloads, we observe that the utilization of main {GPU} resources is only up to 25\%. The underutilization leads to low system throughput.
            To address the problem, this paper proposes concurrent query execution as an effective solution. To efficiently share {GPUs} among concurrent queries for high throughput, the major challenge is to provide software support to control and resolve resource contention incurred by the sharing. Our solution relies on {GPU} query scheduling and device memory swapping policies to address this challenge. We have implemented a prototype system and evaluated it intensively. The experiment results confirm the effectiveness and performance advantage of our approach. By executing multiple {GPU} queries concurrently, system throughput can be improved by up to 55\% compared with dedicated processing.},
	pages = {1011--1022},
	number = {11},
	journaltitle = {Proceedings of the {VLDB} Endowment},
	shortjournal = {Proc. {VLDB} Endow.},
	author = {Wang, Kaibo and Zhang, Kai and Yuan, Yuan and Ma, Siyuan and Lee, Rubao and Ding, Xiaoning and Zhang, Xiaodong},
	urldate = {2026-05-13},
	date = {2014-07},
	langid = {english},
	file = {PDF:/Users/zyl/Zotero/storage/WP5JZE8Q/Wang 等 - 2014 - Concurrent analytical query processing with GPUs.pdf:application/pdf},
}

@article{li_mitra_2023,
	title = {{MITra}: A Framework for Multi-Instance Graph Traversal},
	volume = {16},
	issn = {2150-8097},
	url = {https://dl.acm.org/doi/10.14778/3603581.3603594},
	doi = {10.14778/3603581.3603594},
	shorttitle = {{MITra}},
	abstract = {This paper presents {MITra}, a framework for composing multi-instance graph algorithms that traverse from multiple source vertices simultaneously over a single thread. Underlying {MITra} is a model of multi-instance traversal that uniformly captures traversal sharing across instances. Based on this, {MITra} provides a programming model that allows users to express traversals by declaring vertex ranks and specify computation logic via an edge function. It synthesizes multi-instance traversal algorithms from declared vertex ranks and edge functions adopted from classic single-instance algorithms, automatically sharing computation across instances and benefiting from {SIMD}. We show that {MITra} can generate multi-instance algorithms provably better than existing ones, while being more expressive than traditional frameworks. In addition to the ease of programming, we experimentally verify that {MITra} is on average an order of magnitude faster than approaches based on existing frameworks for common graph algorithms, and is comparable to the state-of-the-art highly optimized one-off algorithms.},
	pages = {2551--2564},
	number = {10},
	journaltitle = {Proceedings of the {VLDB} Endowment},
	shortjournal = {Proc. {VLDB} Endow.},
	author = {Li, Jia and Zhao, Wenyue and Ntarmos, Nikos and Cao, Yang and Buneman, Peter},
	urldate = {2026-05-21},
	date = {2023-06},
	langid = {english},
	file = {PDF:/Users/zyl/Zotero/storage/I34LEN5D/Li 等 - 2023 - MITra A Framework for Multi-Instance Graph Traversal.pdf:application/pdf},
}

@article{zhao_automating_2024,
	title = {Automating Vectorized Distributed Graph Computation},
	volume = {2},
	rights = {https://creativecommons.org/licenses/by/4.0/},
	issn = {2836-6573},
	url = {https://dl.acm.org/doi/10.1145/3698833},
	doi = {10.1145/3698833},
	abstract = {Multi-instance graph algorithms interleave the evaluation of multiple instances of the same algorithm with different inputs over the same graph. They have been shown to be significantly faster than traditional serial and batch evaluation, by sharing computation across instances. However, writing correct multi-instance algorithms is challenging; and in this work, we describe {AutoMI}, a framework for automatically converting vertex-centric graph algorithms into their vectorized multi-instance versions. We also develop an algebraic characterization of algorithms that can benefit best from multi-instance computation with simpler and faster streamlined vectorization. This allows users to decide when to use such optimization and instruct {AutoMI} to make the best use of {SIMD} vectorization. Using 6 real-life graphs, we show that {AutoMI}-converted multi-instance algorithms are 9.6 to 29.5 times faster than serial evaluation, 7.1 to 26.4 times faster than batch evaluation, and are even 2.6 to 4.6 times faster than existing highly optimized handcrafted multi-instance algorithms without vectorization.},
	pages = {1--27},
	number = {6},
	journaltitle = {Proceedings of the {ACM} on Management of Data},
	shortjournal = {Proc. {ACM} Manag. Data},
	author = {Zhao, Wenyue and Cao, Yang and Buneman, Peter and Li, Jia and Ntarmos, Nikos},
	urldate = {2026-05-21},
	date = {2024-12-18},
	langid = {english},
	file = {Full Text PDF:/Users/zyl/Zotero/storage/V32EQBJG/Zhao 等 - 2024 - Automating Vectorized Distributed Graph Computation.pdf:application/pdf},
}

