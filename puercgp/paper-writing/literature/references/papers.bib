	author = {Xu, Xianghao and Wang, Fang and Jiang, Hong and Cheng, Yongli and Feng, Dan and Zhang, Yongxuan and Fang, Peng},
	urldate = {2026-05-07},
	date = {2021-06-25},
	langid = {english},
	file = {PDF:/Users/zyl/Zotero/storage/FADDLDB6/Xu 等 - 2021 - GraphCP An IO-Efficient Concurrent Graph Processing Framework.pdf:application/pdf},
